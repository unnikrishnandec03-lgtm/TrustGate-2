rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Forensic scan audit records
    match /scans/{scanId} {
      allow read: if true; // Allow dashboard observers to review triage stream
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && request.auth.token.admin == true;
    }

    // Quarantined entities
    match /quarantine/{quarantineId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
