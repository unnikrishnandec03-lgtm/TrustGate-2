{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile for TrustGate Sentinel security operator",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase user ID" },
        "email": { "type": "string", "format": "email", "description": "Operator email" },
        "displayName": { "type": "string", "description": "Operator display name" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "role": { "type": "string", "enum": ["OPERATOR", "ANALYST", "ADMIN"], "description": "Access control role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "ScanAuditRecord": {
      "title": "ScanAuditRecord",
      "description": "Forensic scan audit log record generated by TrustGate Sentinel",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique scan identifier" },
        "targetName": { "type": "string", "description": "Target asset or filename" },
        "vector": { "type": "string", "description": "Threat vector category" },
        "riskScore": { "type": "number", "description": "Composite risk score (0-100)" },
        "confidence": { "type": "number", "description": "Forensic confidence score (0-1)" },
        "verdict": { "type": "string", "enum": ["AUTHENTIC", "SUSPICIOUS", "CRITICAL_FRAUD"], "description": "Triage verdict" },
        "latencyMs": { "type": "number", "description": "Inference latency in milliseconds" },
        "enforcement": { "type": "string", "description": "Enforcement action disposition" },
        "sha256": { "type": "string", "description": "Cryptographic SHA-256 fingerprint" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Scan event timestamp" },
        "userId": { "type": "string", "description": "Operator who initiated the scan" }
      },
      "required": ["id", "targetName", "riskScore", "verdict"]
    },
    "QuarantinedEntity": {
      "title": "QuarantinedEntity",
      "description": "Compromised credential or transaction isolated in the HSM quarantine vault",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique quarantine ID" },
        "sha256": { "type": "string", "description": "Compromised SHA-256 hash" },
        "targetName": { "type": "string", "description": "Target asset name" },
        "vector": { "type": "string", "description": "Identified threat vector" },
        "riskScore": { "type": "number", "description": "Risk score at quarantine" },
        "quarantinedAt": { "type": "string", "format": "date-time", "description": "Isolation timestamp" },
        "operatorEmail": { "type": "string", "description": "Authorizing operator" },
        "status": { "type": "string", "enum": ["ACTIVE_LOCK", "RELEASED", "EVIDENCE_EXPORTED"] }
      },
      "required": ["id", "sha256", "riskScore"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile store for authenticated operators"
    },
    "/scans/{scanId}": {
      "schema": { "$ref": "#/entities/ScanAuditRecord" },
      "description": "Historical forensic scans and triage logs"
    },
    "/quarantine/{quarantineId}": {
      "schema": { "$ref": "#/entities/QuarantinedEntity" },
      "description": "Quarantined identities, documents, and transaction collusion anchors"
    }
  }
}
